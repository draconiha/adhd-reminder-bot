[Unit]
Description=ADHD Reminder Bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/adhd-reminder-bot
ExecStart=/root/adhd-reminder-bot/venv/bin/python /root/adhd-reminder-bot/bot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
